# PinkBakes frontend environment example
# Copy to .env / .env.local. Never put KEY_SECRET or WEBHOOK_SECRET here.

VITE_API_URL=https://api.pinkbakes.com
VITE_RAZORPAY_KEY_ID=
# Optional maps
# VITE_GOOGLE_MAPS_API_KEY=

# Public site origin for canonical URLs and Open Graph (no trailing slash)
VITE_PUBLIC_SITE_URL=https://pinkbakes.com

# --- Firebase Function sitemap proxy (not a Vite var) ---
# Set API_ORIGIN in functions/.env (copied from functions/.env.example) so the
# Hosting rewrite for /sitemap.xml can fetch Django's dynamic sitemap.
# Example: API_ORIGIN=https://YOUR_DJANGO_API_HOST
# Robots stay static in public/robots.txt and already point at:
#   Sitemap: https://pinkbakes.com/sitemap.xml