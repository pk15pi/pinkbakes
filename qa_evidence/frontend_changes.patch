+
+/* Phone header: keep the brand inside its own box (it overlapped the account/cart pills),
+   and show icon-only header pills on narrow phones; buttons keep aria-label/title. */
+@media (max-width: 720px) {
+  .header .brand {
+    flex: 1 1 auto;
+    overflow: hidden;
+  }
+
+  .header .brand > div:last-child {
+    min-width: 0;
+  }
+
+  .header .brand strong,
+  .header .brand small {
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+  }
+
+  .header .header-actions {
+    flex: 0 0 auto;
+  }
+}
+
+@media (max-width: 480px) {
+  .header .header-action .action-label {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    white-space: nowrap;
+  }
+
+  .header .header-action {
+    min-width: 44px;
+    padding: 0 12px;
+  }
+}
+
+/* The add-to-cart toast sits over the cart/checkout CTA on phones; let taps pass through it. */
+.toast {
+  pointer-events: none;
+}
+
+/* Card and modal prices: keep the sale price and the struck-through original price apart. */
+.price-row,
+.modal-price-row {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: 8px;
+}
+
+.price-row .strike,
+.modal-price-row .strike {
+  color: #92765c;
+  font-size: 0.85em;
+  font-weight: 500;
+  text-decoration: line-through;
+}
