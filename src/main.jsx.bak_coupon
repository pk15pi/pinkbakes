  function resetCakeForm() {
    setCakeForm({
      name: "",
      price: "",
      discount: "",
      category: "Birthday Cakes",
      description: "",
      image: "",
      availability: "in_stock",
      status: "published",
      available_quantity: 50,
      low_stock_threshold: 5
